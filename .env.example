# ---------------------------------------------------------------------------
# odoo service  (build from ./odoo)
# ---------------------------------------------------------------------------

# Master password guarding the database-manager screens. Generate one:
#   openssl rand -hex 24
# Required -- the entrypoint refuses to start without it.
ODOO_ADMIN_PASSWD=replace-me-with-a-random-48-char-hex-string

# PostgreSQL connection. These are libpq variable names on purpose: the base
# image's entrypoint reads $PORT as the *PostgreSQL* port, so using its own
# HOST/PORT/USER/PASSWORD variables would collide with Railway's $PORT.
PGHOST=${{Postgres.RAILWAY_PRIVATE_DOMAIN}}
PGPORT=5432

# Must NOT be `postgres`. Odoo 19 exits at startup if the role is named that,
# and Railway's managed PostgreSQL hands out exactly that superuser. Create a
# scoped role on the database first:
#   CREATE ROLE odoo WITH LOGIN CREATEDB NOSUPERUSER NOCREATEROLE NOREPLICATION
#     PASSWORD '<PGPASSWORD below>';
# CREATEDB is required: Odoo uses it to create, duplicate and restore
# databases, and to bootstrap the database named by db_name on first boot.
PGUSER=odoo
PGPASSWORD=replace-me-with-the-scoped-role-password

# Port Railway health-checks and routes to for this service.
PORT=8069

# ---------------------------------------------------------------------------
# odoo-proxy service  (build from ./proxy)
# ---------------------------------------------------------------------------

PORT=8080

# Private hostname of the Odoo service. Only needed if that service is not
# named `odoo`; the entrypoint defaults to odoo.railway.internal.
# ODOO_UPSTREAM_HOST=odoo.railway.internal
